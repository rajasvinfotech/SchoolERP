@page "/students/{Id:int}"
@rendermode InteractiveServer
@inject AppState AppState
@inject StudentService StudentService
@inject FeeService FeeService
@inject NavigationManager Nav

<PageTitle>Student Profile - School ERP</PageTitle>

@if (isLoading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (student == null)
{
    <div class="alert alert-warning">Student not found.</div>
}
else
{
    <div class="d-flex align-items-start justify-content-between mb-4">
        <div class="d-flex gap-3">
            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold"
                 style="width:60px;height:60px;font-size:1.5rem">
                @student.FullName[0]
            </div>
            <div>
                <h4 class="fw-bold mb-0">@student.FullName</h4>
                <div class="text-muted small">
                    <code>@student.AdmissionNumber</code> &bull;
                    @(student.Class?.Name ?? "No Class")@(student.Section != null ? " - " + student.Section.Name : "")
                </div>
                <span class="badge @GetStatusBadge(student.Status) mt-1">@student.Status</span>
            </div>
        </div>
        <div class="d-flex gap-2">
            @if (!string.IsNullOrEmpty(student.FatherPhone))
            {
                <a href="https://wa.me/91@student.FatherPhone" target="_blank" class="btn btn-sm wa-btn">
                    <i class="bi bi-whatsapp me-1"></i>WhatsApp
                </a>
            }
            @if (AppState.CanManageStudents)
            {
                <a href="/students/@Id/edit" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-pencil me-1"></i>Edit
                </a>
            }
            @if (AppState.CanCollectFee)
            {
                <a href="/fees/collect?studentId=@Id" class="btn btn-sm btn-primary">
                    <i class="bi bi-cash-coin me-1"></i>Collect Fee
                </a>
            }
        </div>
    </div>

    <div class="row g-3">
        <!-- Profile Info -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-bold py-2 border-bottom">
                    <i class="bi bi-person me-2 text-primary"></i>Personal Info
                </div>
                <div class="card-body">
                    <InfoRow Label="Date of Birth" Value="@(student.DateOfBirth?.ToString("dd/MM/yyyy") ?? "-")" />
                    <InfoRow Label="Gender" Value="@(student.Gender ?? "-")" />
                    <InfoRow Label="Blood Group" Value="@(student.BloodGroup ?? "-")" />
                    <InfoRow Label="Aadhar" Value="@(student.AadharNumber ?? "-")" />
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-bold py-2 border-bottom">
                    <i class="bi bi-people me-2 text-success"></i>Parents
                </div>
                <div class="card-body">
                    <InfoRow Label="Father" Value="@(student.FatherName ?? "-")" />
                    <InfoRow Label="Father Phone" Value="@(student.FatherPhone ?? "-")" />
                    <InfoRow Label="Occupation" Value="@(student.FatherOccupation ?? "-")" />
                    <hr class="my-2" />
                    <InfoRow Label="Mother" Value="@(student.MotherName ?? "-")" />
                    <InfoRow Label="Mother Phone" Value="@(student.MotherPhone ?? "-")" />
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold py-2 border-bottom">
                    <i class="bi bi-geo-alt me-2 text-warning"></i>Address
                </div>
                <div class="card-body">
                    <InfoRow Label="Address" Value="@(student.Address ?? "-")" />
                    <InfoRow Label="City" Value="@(student.City ?? "-")" />
                    <InfoRow Label="Pincode" Value="@(student.Pincode ?? "-")" />
                    @if (student.TransportRequired)
                    {
                        <hr class="my-2" />
                        <InfoRow Label="Route" Value="@(student.TransportRoute ?? "-")" />
                        <InfoRow Label="Stop" Value="@(student.TransportStop ?? "-")" />
                    }
                </div>
            </div>
        </div>

        <!-- Fee History -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex align-items-center justify-content-between py-2 border-bottom">
                    <span class="fw-bold"><i class="bi bi-receipt me-2 text-primary"></i>Fee Payment History</span>
                    <span class="badge bg-success fs-6">Total Paid: ₹@payments.Where(p => p.Status == "Active").Sum(p => p.NetAmount).ToString("N0")</span>
                </div>
                <div class="card-body p-0">
                    @if (payments.Count == 0)
                    {
                        <div class="text-center text-muted py-4">No payments found</div>
                    }
                    else
                    {
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Receipt No</th>
                                    <th>Date</th>
                                    <th>Month</th>
                                    <th>Amount</th>
                                    <th>Mode</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in payments)
                                {
                                    <tr class="@(p.Status == "Cancelled" ? "text-muted" : "")">
                                        <td><code>@p.ReceiptNumber</code></td>
                                        <td>@p.PaymentDate.ToString("dd/MM/yyyy")</td>
                                        <td>@p.Month</td>
                                        <td class="fw-bold @(p.Status == "Cancelled" ? "text-muted" : "text-success")">
                                            ₹@p.NetAmount.ToString("N0")
                                        </td>
                                        <td><span class="badge bg-secondary">@p.PaymentMode</span></td>
                                        <td>
                                            @if (p.Status == "Cancelled")
                                            {
                                                <span class="badge badge-cancelled">Cancelled</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-paid">Active</span>
                                            }
                                        </td>
                                        <td>
                                            @if (p.Status == "Active")
                                            {
                                                <a href="/api/receipt/@p.Id" target="_blank"
                                                   class="btn btn-sm btn-outline-primary" title="Print">
                                                    <i class="bi bi-printer"></i>
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Student? student;
    private List<FeePayment> payments = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        student = await StudentService.GetByIdAsync(Id);
        if (student != null)
            payments = await FeeService.GetPaymentHistoryAsync(Id);
        isLoading = false;
    }

    private static string GetStatusBadge(string status) => status switch
    {
        "Active" => "badge-active",
        "Inactive" => "badge-inactive",
        _ => "bg-secondary"
    };
}
