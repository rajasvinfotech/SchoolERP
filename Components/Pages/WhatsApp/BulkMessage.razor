@page "/whatsapp/send"
@rendermode InteractiveServer
@inject AppState AppState
@inject WhatsAppService WhatsAppService
@inject StudentService StudentService
@inject ClassService ClassService
@inject SchoolService SchoolService
@inject IToastService Toast
@inject IJSRuntime JS

<PageTitle>Send WhatsApp - School ERP</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-whatsapp me-2 text-success"></i>Bulk WhatsApp Message</h4>
</div>

<div class="row g-3">
    <!-- Left: Template + Recipients -->
    <div class="col-12 col-lg-8">
        <!-- Template Selection -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white py-3 border-bottom fw-bold">
                <i class="bi bi-file-text me-2 text-primary"></i>Step 1: Select Template
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Template</label>
                        <select class="form-select" @bind="selectedTemplateId" @bind:after="OnTemplateChange">
                            <option value="0">-- Select Template --</option>
                            @foreach (var t in templates)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Message Body</label>
                        <textarea class="form-control" rows="5" @bind="messageBody"></textarea>
                        <div class="form-text">
                            Variables: {student_name}, {father_name}, {amount}, {month}, {school_name}, {date}, {receipt_no}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recipient Filter -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white py-3 border-bottom fw-bold">
                <i class="bi bi-funnel me-2 text-primary"></i>Step 2: Select Recipients
            </div>
            <div class="card-body">
                <div class="row g-2 mb-3">
                    <div class="col-md-3">
                        <select class="form-select" @bind="filterClassId" @bind:after="LoadStudents">
                            <option value="0">All Classes</option>
                            @foreach (var c in classes)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" @bind="filterStatus" @bind:after="LoadStudents">
                            <option value="Active">Active Only</option>
                            <option value="">All Students</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-outline-primary btn-sm me-2" @onclick="SelectAllStudents">Select All</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="DeselectAll">Deselect All</button>
                    </div>
                </div>

                <div style="max-height:300px;overflow-y:auto;border:1px solid #dee2e6;border-radius:8px">
                    @if (students.Count == 0)
                    {
                        <div class="text-center text-muted py-3">No students found</div>
                    }
                    else
                    {
                        <table class="table table-sm mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th style="width:40px"><input type="checkbox" @onchange="SelectAllStudents2" /></th>
                                    <th>Name</th>
                                    <th>Class</th>
                                    <th>Phone</th>
                                    <th>Valid?</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in students)
                                {
                                    var isValid = IsValidPhone(s.FatherPhone);
                                    <tr class="@(!isValid ? "table-warning" : "")">
                                        <td><input type="checkbox" checked="@selectedStudentIds.Contains(s.Id)"
                                                   disabled="@(!isValid)"
                                                   @onchange="e => ToggleStudent(s.Id, (bool)e.Value!)" /></td>
                                        <td class="small">@s.FullName</td>
                                        <td class="small">@(s.Class?.Name ?? "-")</td>
                                        <td class="small">@(s.FatherPhone ?? "N/A")</td>
                                        <td>
                                            @if (isValid) { <i class="bi bi-check-circle-fill text-success"></i> }
                                            else { <i class="bi bi-exclamation-triangle-fill text-warning" title="Invalid phone"></i> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Summary + Send -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm sticky-top" style="top:70px">
            <div class="card-header bg-success text-white py-3 fw-bold">
                <i class="bi bi-send-fill me-2"></i>Step 3: Send
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Selected Recipients</span>
                        <strong class="text-success">@selectedStudentIds.Count</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Invalid Numbers</span>
                        <strong class="text-warning">@students.Count(s => !IsValidPhone(s.FatherPhone))</strong>
                    </div>
                </div>

                @if (isSending)
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between text-muted small mb-1">
                            <span>Progress</span>
                            <span>@sentCount / @selectedStudentIds.Count</span>
                        </div>
                        <div class="progress" style="height:8px">
                            <div class="progress-bar bg-success" style="width:@(selectedStudentIds.Count > 0 ? sentCount * 100 / selectedStudentIds.Count : 0)%"></div>
                        </div>
                        <div class="text-muted small mt-1">@currentSendingName</div>
                    </div>
                }

                @if (sendComplete)
                {
                    <div class="alert alert-success py-2 mb-3">
                        <i class="bi bi-check-circle me-1"></i>
                        Sent @sentCount messages successfully!
                    </div>
                }

                <button class="btn btn-success w-100 py-2"
                        @onclick="StartSending"
                        disabled="@(isSending || selectedStudentIds.Count == 0 || string.IsNullOrEmpty(messageBody))">
                    @if (isSending)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Sending...</span>
                    }
                    else
                    {
                        <i class="bi bi-whatsapp me-2"></i>
                        <span>Send WhatsApp Messages</span>
                    }
                </button>
                <div class="form-text text-center mt-2">
                    Each message will open in a new tab (WhatsApp Web)
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Students { get; set; }

    private List<MessageTemplate> templates = new();
    private List<Student> students = new();
    private List<Class> classes = new();
    private HashSet<int> selectedStudentIds = new();
    private int selectedTemplateId;
    private string messageBody = string.Empty;
    private int filterClassId;
    private string filterStatus = "Active";
    private bool isSending;
    private bool sendComplete;
    private int sentCount;
    private string currentSendingName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        templates = await WhatsAppService.GetTemplatesAsync(AppState.CurrentSchoolId);
        if (templates.Count == 0)
        {
            await WhatsAppService.SeedDefaultTemplatesAsync(AppState.CurrentSchoolId);
            templates = await WhatsAppService.GetTemplatesAsync(AppState.CurrentSchoolId);
        }
        classes = await ClassService.GetClassesAsync(AppState.CurrentSchoolId);
        await LoadStudents();

        // Pre-select students from query
        if (!string.IsNullOrEmpty(Students))
        {
            foreach (var idStr in Students.Split(','))
            {
                if (int.TryParse(idStr, out var id))
                    selectedStudentIds.Add(id);
            }
        }
    }

    private async Task LoadStudents()
    {
        (students, _) = await StudentService.GetPagedAsync(
            AppState.CurrentSchoolId, null,
            filterClassId > 0 ? filterClassId : null,
            null, filterStatus, 1, 500);
    }

    private void OnTemplateChange()
    {
        var t = templates.FirstOrDefault(t => t.Id == selectedTemplateId);
        if (t != null) messageBody = t.Body;
    }

    private void SelectAllStudents() => students.Where(s => IsValidPhone(s.FatherPhone)).ToList().ForEach(s => selectedStudentIds.Add(s.Id));
    private void SelectAllStudents2(ChangeEventArgs e) { if ((bool)e.Value!) SelectAllStudents(); else DeselectAll(); }
    private void DeselectAll() => selectedStudentIds.Clear();
    private void ToggleStudent(int id, bool sel) { if (sel) selectedStudentIds.Add(id); else selectedStudentIds.Remove(id); }

    private async Task StartSending()
    {
        if (string.IsNullOrEmpty(messageBody)) return;

        isSending = true;
        sentCount = 0;
        sendComplete = false;

        var selectedStudents = students.Where(s => selectedStudentIds.Contains(s.Id) && IsValidPhone(s.FatherPhone)).ToList();
        var school = await SchoolService.GetByIdAsync(AppState.CurrentSchoolId);

        foreach (var s in selectedStudents)
        {
            currentSendingName = s.FullName;
            StateHasChanged();

            var vars = new Dictionary<string, string>
            {
                ["student_name"] = s.FullName,
                ["father_name"] = s.FatherName ?? "",
                ["school_name"] = school?.Name ?? "",
                ["date"] = DateTime.Today.ToString("dd/MM/yyyy"),
                ["month"] = DateTime.Today.ToString("MMM yyyy"),
                ["amount"] = "0",
                ["receipt_no"] = ""
            };

            var msg = WhatsAppService.BuildMessage(messageBody, vars);
            var url = WhatsAppService.GetWhatsAppUrl(s.FatherPhone!, msg);

            await JS.InvokeVoidAsync("open", url, "_blank");

            sentCount++;
            await Task.Delay(3000); // 3 second delay
        }

        // Log
        await WhatsAppService.LogMessageAsync(new MessageLog
        {
            SchoolId = AppState.CurrentSchoolId,
            TemplateId = selectedTemplateId,
            TemplateName = templates.FirstOrDefault(t => t.Id == selectedTemplateId)?.Name ?? "Custom",
            TotalRecipients = selectedStudentIds.Count,
            SuccessCount = sentCount,
            FailedCount = selectedStudentIds.Count - sentCount,
            SentBy = AppState.FullName,
            SentByUserId = AppState.UserId,
            Method = "WhatsAppLink"
        });

        isSending = false;
        sendComplete = true;
        Toast.ShowSuccess($"Sent {sentCount} messages!");
    }

    private static bool IsValidPhone(string? phone) =>
        !string.IsNullOrEmpty(phone) && phone.Replace(" ", "").Replace("-", "").Length >= 10;
}
