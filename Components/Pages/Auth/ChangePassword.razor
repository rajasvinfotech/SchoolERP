@page "/change-password"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject AppState AppState
@inject NavigationManager Nav
@inject IToastService Toast

<PageTitle>Change Password</PageTitle>

<div class="d-flex align-items-center justify-content-center" style="min-height:60vh">
    <div class="card shadow border-0" style="width:420px;border-radius:16px!important;">
        <div class="card-header bg-primary text-white rounded-top-4 p-4">
            <h5 class="mb-0"><i class="bi bi-key-fill me-2"></i>Change Password</h5>
            @if (AppState.Role == "SuperAdmin" || !string.IsNullOrEmpty(AppState.Username))
            {
                <small>Please change your password to continue</small>
            }
        </div>
        <div class="card-body p-4">
            <EditForm Model="model" OnValidSubmit="HandleChange">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Current Password</label>
                    <input type="password" class="form-control" @bind="model.CurrentPassword" />
                </div>

                <div class="mb-3">
                    <label class="form-label">New Password</label>
                    <input type="password" class="form-control" @bind="model.NewPassword" />
                    <div class="form-text">Minimum 6 characters</div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Confirm New Password</label>
                    <input type="password" class="form-control" @bind="model.ConfirmPassword" />
                </div>

                @if (!string.IsNullOrEmpty(errorMsg))
                {
                    <div class="alert alert-danger py-2">@errorMsg</div>
                }

                <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                    @if (isLoading) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    Update Password
                </button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private ChangePasswordModel model = new();
    private bool isLoading;
    private string errorMsg = string.Empty;

    private async Task HandleChange()
    {
        if (model.NewPassword != model.ConfirmPassword)
        {
            errorMsg = "Passwords do not match.";
            return;
        }
        if (model.NewPassword.Length < 6)
        {
            errorMsg = "Password must be at least 6 characters.";
            return;
        }

        isLoading = true;
        var success = await AuthService.ChangePasswordAsync(AppState.UserId, model.CurrentPassword, model.NewPassword);

        if (!success)
        {
            errorMsg = "Current password is incorrect.";
            isLoading = false;
            return;
        }

        Toast.ShowSuccess("Password changed successfully!");
        Nav.NavigateTo("/");
    }

    public class ChangePasswordModel
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
