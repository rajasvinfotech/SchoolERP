@page "/fees/collect"
@rendermode InteractiveServer
@inject AppState AppState
@inject StudentService StudentService
@inject FeeService FeeService
@inject ClassService ClassService
@inject IToastService Toast
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Collect Fee - School ERP</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-cash-coin me-2 text-success"></i>Collect Fee</h4>
</div>

@if (receiptGenerated && lastPayment != null)
{
    <!-- Receipt Generated -->
    <div class="card border-0 shadow-sm border-success" style="border-left:4px solid #198754!important">
        <div class="card-body text-center py-4">
            <div class="text-success fs-1 mb-2"><i class="bi bi-check-circle-fill"></i></div>
            <h5 class="text-success fw-bold">Fee Collected Successfully!</h5>
            <p class="mb-1">Receipt No: <strong>@lastPayment.ReceiptNumber</strong></p>
            <p class="mb-3">Amount: <strong class="text-success fs-5">₹@lastPayment.NetAmount.ToString("N0")</strong></p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/api/receipt/@lastPayment.Id" target="_blank" class="btn btn-primary">
                    <i class="bi bi-printer me-1"></i>Print Receipt
                </a>
                <a href="/api/receipt/@lastPayment.Id/duplicate" target="_blank" class="btn btn-outline-primary">
                    <i class="bi bi-files me-1"></i>Print Duplicate
                </a>
                @if (!string.IsNullOrEmpty(lastPayment.Student?.FatherPhone))
                {
                    <a href="https://wa.me/91@lastPayment.Student.FatherPhone?text=@Uri.EscapeDataString(BuildWhatsAppMsg())"
                       target="_blank" class="btn wa-btn">
                        <i class="bi bi-whatsapp me-1"></i>Send Receipt on WhatsApp
                    </a>
                }
                <button class="btn btn-success" @onclick="ResetForm">
                    <i class="bi bi-plus-circle me-1"></i>Collect Another Fee
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        <!-- Step 1: Student Search -->
        <div class="col-12 col-lg-8">
            @if (selectedStudent == null)
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-primary text-white py-2">
                        <i class="bi bi-search me-2"></i>Step 1: Search Student
                    </div>
                    <div class="card-body">
                        <div class="position-relative">
                            <div class="input-group input-group-lg">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control" placeholder="Type student name or admission number..."
                                       @bind="searchTerm" @bind:event="oninput" @oninput="OnStudentSearch" />
                            </div>
                            @if (searchResults.Count > 0)
                            {
                                <div class="position-absolute w-100 bg-white border shadow-lg rounded-3 mt-1"
                                     style="z-index:1000;max-height:300px;overflow-y:auto">
                                    @foreach (var s in searchResults)
                                    {
                                        <div class="p-3 border-bottom cursor-pointer d-flex align-items-center gap-3 hover-bg"
                                             @onclick="() => SelectStudent(s)" style="cursor:pointer">
                                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                                 style="width:36px;height:36px;min-width:36px;font-size:0.9rem;font-weight:700">
                                                @s.FullName[0]
                                            </div>
                                            <div>
                                                <div class="fw-semibold">@s.FullName</div>
                                                <div class="text-muted small">
                                                    <code>@s.AdmissionNumber</code> &bull;
                                                    @(s.Class?.Name ?? "") &bull;
                                                    @(s.FatherName ?? "") &bull;
                                                    @(s.FatherPhone ?? "")
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Student Card -->
                <div class="student-search-result mb-3">
                    <div class="d-flex align-items-start justify-content-between">
                        <div class="d-flex gap-3">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                 style="width:50px;height:50px;font-size:1.2rem">
                                @selectedStudent.FullName[0]
                            </div>
                            <div>
                                <h5 class="mb-1 fw-bold">@selectedStudent.FullName</h5>
                                <div class="text-muted small">
                                    <code>@selectedStudent.AdmissionNumber</code> &bull;
                                    @(selectedStudent.Class?.Name ?? "") @(selectedStudent.Section != null ? "- " + selectedStudent.Section.Name : "")
                                    &bull; Roll: @(selectedStudent.RollNumber ?? "-")
                                </div>
                                <div class="small mt-1">
                                    Father: <strong>@(selectedStudent.FatherName ?? "-")</strong>
                                    &bull; Phone: <strong>@(selectedStudent.FatherPhone ?? "-")</strong>
                                </div>
                            </div>
                        </div>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => selectedStudent = null">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>

                <!-- Step 2: Fee Details -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-info text-white py-2">
                        <i class="bi bi-list-columns me-2"></i>Step 2: Fee Details
                    </div>
                    <div class="card-body">
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Month / Period</label>
                                <input type="month" class="form-control"
                                       @bind="selectedMonthValue" @bind:after="OnMonthChange" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Academic Year</label>
                                <input class="form-control" @bind="payment.AcademicYear" />
                            </div>
                        </div>

                        <table class="table table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Fee Head</th>
                                    <th>Type</th>
                                    <th style="width:150px">Amount (₹)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in details)
                                {
                                    <tr>
                                        <td>@d.FeeHeadName</td>
                                        <td><span class="badge bg-light text-dark">@GetFeeType(d.FeeHeadId)</span></td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm text-end"
                                                   @bind="d.Amount" @bind:after="RecalcTotal" min="0" step="1" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Discount (₹)</label>
                                <input type="number" class="form-control" @bind="payment.Discount" @bind:after="RecalcTotal" min="0" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Discount Reason</label>
                                <input class="form-control" @bind="payment.DiscountReason" placeholder="e.g., Staff ward, Scholarship" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Late Fine (₹)</label>
                                <input type="number" class="form-control" @bind="payment.LateFine" @bind:after="RecalcTotal" min="0" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Previous Due (₹)</label>
                                <input type="number" class="form-control" @bind="payment.PreviousDue" @bind:after="RecalcTotal" min="0" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 3: Payment Mode -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-success text-white py-2">
                        <i class="bi bi-credit-card me-2"></i>Step 3: Payment Details
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Payment Mode *</label>
                                <select class="form-select" @bind="payment.PaymentMode" @bind:after="StateHasChanged">
                                    <option value="Cash">💵 Cash</option>
                                    <option value="UPI">📱 UPI / Online</option>
                                    <option value="Cheque">🏦 Cheque</option>
                                    <option value="DD">📄 DD</option>
                                </select>
                            </div>
                            @if (payment.PaymentMode == "UPI")
                            {
                                <div class="col-md-4">
                                    <label class="form-label">Transaction / UPI Reference</label>
                                    <input class="form-control" @bind="payment.PaymentReference" placeholder="UPI Ref No" />
                                </div>
                            }
                            @if (payment.PaymentMode == "Cheque")
                            {
                                <div class="col-md-4">
                                    <label class="form-label">Cheque Number</label>
                                    <input class="form-control" @bind="payment.PaymentReference" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Bank Name</label>
                                    <input class="form-control" @bind="payment.BankName" />
                                </div>
                            }
                            @if (payment.PaymentMode == "DD")
                            {
                                <div class="col-md-4">
                                    <label class="form-label">DD Number</label>
                                    <input class="form-control" @bind="payment.PaymentReference" />
                                </div>
                            }
                            <div class="col-12">
                                <label class="form-label">Remarks</label>
                                <input class="form-control" @bind="payment.Remarks" placeholder="Optional remarks" />
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Summary Sidebar -->
        @if (selectedStudent != null)
        {
            <div class="col-12 col-lg-4">
                <div class="fee-summary-box sticky-top" style="top:70px">
                    <div class="mb-3">
                        <div class="fw-semibold opacity-75 small">PAYMENT SUMMARY</div>
                        <div class="fw-bold fs-5 mt-1">@selectedStudent.FullName</div>
                        <div class="opacity-75 small">@payment.Month</div>
                    </div>

                    <div class="d-flex justify-content-between py-1 border-bottom border-white border-opacity-25">
                        <span class="opacity-75">Sub Total</span>
                        <span class="fw-semibold">₹@details.Sum(d => d.Amount).ToString("N0")</span>
                    </div>

                    @if (payment.PreviousDue > 0)
                    {
                        <div class="d-flex justify-content-between py-1 border-bottom border-white border-opacity-25">
                            <span class="opacity-75">Previous Due</span>
                            <span class="fw-semibold text-warning">+₹@payment.PreviousDue.ToString("N0")</span>
                        </div>
                    }

                    @if (payment.LateFine > 0)
                    {
                        <div class="d-flex justify-content-between py-1 border-bottom border-white border-opacity-25">
                            <span class="opacity-75">Late Fine</span>
                            <span class="fw-semibold text-warning">+₹@payment.LateFine.ToString("N0")</span>
                        </div>
                    }

                    @if (payment.Discount > 0)
                    {
                        <div class="d-flex justify-content-between py-1 border-bottom border-white border-opacity-25">
                            <span class="opacity-75">Discount</span>
                            <span class="fw-semibold text-success">-₹@payment.Discount.ToString("N0")</span>
                        </div>
                    }

                    <div class="mt-3 p-3 bg-white bg-opacity-25 rounded-3 text-center">
                        <div class="opacity-75 small">NET AMOUNT</div>
                        <div class="net-amount">₹@netAmount.ToString("N0")</div>
                    </div>

                    <button class="btn btn-light text-primary fw-bold w-100 mt-3 py-2"
                            @onclick="ConfirmPayment" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle-fill me-2"></i>
                        }
                        Confirm & Generate Receipt
                    </button>

                    @if (!string.IsNullOrEmpty(errorMsg))
                    {
                        <div class="alert alert-danger mt-2 py-2 text-dark small">@errorMsg</div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery] public int StudentId { get; set; }

    private Student? selectedStudent;
    private string searchTerm = string.Empty;
    private List<Student> searchResults = new();
    private FeePayment payment = new() { PaymentMode = "Cash", AcademicYear = $"{DateTime.Today.Year}-{(DateTime.Today.Year + 1) % 100:D2}" };
    private List<FeePaymentDetail> details = new();
    private List<FeeHead> feeHeads = new();
    private string selectedMonthValue = DateTime.Today.ToString("yyyy-MM");
    private decimal netAmount;
    private bool isSaving;
    private string errorMsg = string.Empty;
    private bool receiptGenerated;
    private FeePayment? lastPayment;
    private System.Threading.Timer? debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        payment.Month = DateTime.Today.ToString("MMM yyyy");
        feeHeads = await FeeService.GetFeeHeadsAsync(AppState.CurrentSchoolId);

        if (StudentId > 0)
        {
            var s = await StudentService.GetByIdAsync(StudentId);
            if (s != null) await SelectStudent(s);
        }
    }

    private void OnStudentSearch(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        debounceTimer?.Dispose();
        if (searchTerm.Length < 2) { searchResults.Clear(); return; }
        debounceTimer = new System.Threading.Timer(async _ =>
        {
            searchResults = await StudentService.SearchAsync(AppState.CurrentSchoolId, searchTerm);
            await InvokeAsync(StateHasChanged);
        }, null, 300, System.Threading.Timeout.Infinite);
    }

    private async Task SelectStudent(Student s)
    {
        selectedStudent = await StudentService.GetByIdAsync(s.Id);
        searchResults.Clear();
        searchTerm = string.Empty;

        payment.StudentId = s.Id;
        payment.SchoolId = AppState.CurrentSchoolId;
        payment.PreviousDue = await FeeService.GetPreviousDueAsync(s.Id);

        await LoadFeeStructure();
    }

    private async Task OnMonthChange()
    {
        if (DateTime.TryParse(selectedMonthValue + "-01", out var dt))
            payment.Month = dt.ToString("MMM yyyy");
        await LoadFeeStructure();
    }

    private async Task LoadFeeStructure()
    {
        if (selectedStudent?.ClassId == null) return;

        var year = payment.AcademicYear;
        var structures = await FeeService.GetFeeStructureAsync(selectedStudent.ClassId.Value, year);

        details = structures.Select(s => new FeePaymentDetail
        {
            FeeHeadId = s.FeeHeadId,
            FeeHeadName = s.FeeHead?.Name ?? feeHeads.FirstOrDefault(f => f.Id == s.FeeHeadId)?.Name ?? "Fee",
            Amount = s.Amount
        }).ToList();

        if (details.Count == 0)
        {
            details = feeHeads.Select(fh => new FeePaymentDetail
            {
                FeeHeadId = fh.Id,
                FeeHeadName = fh.Name,
                Amount = 0
            }).ToList();
        }

        RecalcTotal();
    }

    private void RecalcTotal()
    {
        netAmount = details.Sum(d => d.Amount) + payment.PreviousDue + payment.LateFine - payment.Discount;
        if (netAmount < 0) netAmount = 0;
    }

    private async Task ConfirmPayment()
    {
        if (selectedStudent == null) return;

        var activeDetails = details.Where(d => d.Amount > 0).ToList();
        if (activeDetails.Count == 0)
        {
            errorMsg = "Please enter at least one fee amount.";
            return;
        }

        if (netAmount <= 0)
        {
            errorMsg = "Net amount must be greater than 0.";
            return;
        }

        isSaving = true;
        errorMsg = string.Empty;

        try
        {
            payment.PaymentDate = DateTime.Today;
            var result = await FeeService.CollectFeeAsync(payment, activeDetails, AppState.UserId, AppState.Username);
            lastPayment = await FeeService.GetPaymentByIdAsync(result.Id);
            receiptGenerated = true;
        }
        catch (Exception ex)
        {
            errorMsg = $"Error: {ex.Message}";
        }

        isSaving = false;
    }

    private void ResetForm()
    {
        selectedStudent = null;
        payment = new FeePayment { PaymentMode = "Cash", AcademicYear = $"{DateTime.Today.Year}-{(DateTime.Today.Year + 1) % 100:D2}" };
        details.Clear();
        netAmount = 0;
        receiptGenerated = false;
        lastPayment = null;
        errorMsg = string.Empty;
    }

    private string GetFeeType(int feeHeadId) =>
        feeHeads.FirstOrDefault(f => f.Id == feeHeadId)?.Type ?? "Monthly";

    private string BuildWhatsAppMsg()
    {
        if (lastPayment == null) return string.Empty;
        return $"Namaskar {lastPayment.Student?.FatherName} ji,\n{lastPayment.Student?.FullName} ki fees receipt:\nReceipt No: {lastPayment.ReceiptNumber}\nAmount: ₹{lastPayment.NetAmount:N0}\nDate: {lastPayment.PaymentDate:dd/MM/yyyy}\nMonth: {lastPayment.Month}\nThank you!\n- {lastPayment.School?.Name}";
    }
}
