@page "/settings/backup"
@rendermode InteractiveServer
@inject AppState AppState
@inject BackupService BackupService
@inject IToastService Toast

<PageTitle>Backup Manager - School ERP</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-hdd-fill me-2 text-primary"></i>Backup Manager</h4>
</div>

<div class="row g-3 mb-4">
    <!-- Manual Backup -->
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-primary text-white py-3">
                <i class="bi bi-hdd me-2"></i>Manual Backup
            </div>
            <div class="card-body">
                <p class="text-muted small mb-4">Take an immediate backup of the database. Saved to the configured backup folder.</p>
                <button class="btn btn-primary w-100" @onclick="TakeManualBackup" disabled="@isBacking">
                    @if (isBacking)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    else
                    {
                        <i class="bi bi-hdd me-2"></i>
                    }
                    Backup Now
                </button>
                @if (!string.IsNullOrEmpty(backupMsg))
                {
                    <div class="alert alert-success mt-3 mb-0 py-2 small">@backupMsg</div>
                }
            </div>
        </div>
    </div>

    <!-- Pen Drive Backup -->
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-warning text-dark py-3">
                <i class="bi bi-usb-drive me-2"></i>Pen Drive Backup
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Select Drive</label>
                    @if (drives.Count == 0)
                    {
                        <div class="text-muted small">No removable drives detected.</div>
                        <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="RefreshDrives">
                            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                        </button>
                    }
                    else
                    {
                        @foreach (var d in drives)
                        {
                            <div class="form-check">
                                <input type="radio" class="form-check-input" name="drive"
                                       @onchange="() => selectedDrive = d.Letter"
                                       checked="@(selectedDrive == d.Letter)" />
                                <label class="form-check-label">
                                    @d.Label <small class="text-muted">(@((d.FreeBytes / 1024 / 1024 / 1024.0):F1) GB free)</small>
                                </label>
                            </div>
                        }
                    }
                </div>
                <button class="btn btn-warning w-100" @onclick="BackupToPenDrive"
                        disabled="@(string.IsNullOrEmpty(selectedDrive) || isPenDriveBacking)">
                    @if (isPenDriveBacking) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    else { <i class="bi bi-usb-drive me-2"></i> }
                    Backup to Pen Drive
                </button>
                @if (!string.IsNullOrEmpty(penDriveMsg))
                {
                    <div class="alert alert-success mt-3 mb-0 py-2 small">@penDriveMsg</div>
                }
            </div>
        </div>
    </div>

    <!-- Restore -->
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-danger text-white py-3">
                <i class="bi bi-arrow-counterclockwise me-2"></i>Restore from Backup
            </div>
            <div class="card-body">
                <div class="alert alert-warning py-2 small mb-3">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Warning: Restore will replace ALL current data!
                </div>
                <InputFile OnChange="OnRestoreFileSelected" class="form-control mb-3" accept=".db" />
                @if (restoreFile != null)
                {
                    <button class="btn btn-danger w-100" @onclick="ConfirmRestore">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Restore Now
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Backup History -->
<div class="card table-card">
    <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
        <span class="fw-bold"><i class="bi bi-clock-history me-2"></i>Backup History</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshHistory">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
    </div>
    <div class="card-body p-0">
        @if (backupLogs.Count == 0)
        {
            <div class="text-center text-muted py-4">No backups yet</div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Date & Time</th>
                        <th>File Name</th>
                        <th>Size</th>
                        <th>Type</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in backupLogs)
                    {
                        <tr>
                            <td class="small">@b.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")</td>
                            <td class="small text-muted">@b.FileName</td>
                            <td class="small">@(b.FileSizeBytes / 1024.0 / 1024:F1) MB</td>
                            <td>
                                <span class="badge @(b.BackupType == "Auto" ? "bg-info" : b.BackupType == "PenDrive" ? "bg-warning text-dark" : "bg-primary")">
                                    @b.BackupType
                                </span>
                            </td>
                            <td>
                                <a href="/api/backup/download/@b.Id" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-download"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<BackupLog> backupLogs = new();
    private List<(string Letter, string Label, long FreeBytes)> drives = new();
    private string selectedDrive = string.Empty;
    private bool isBacking;
    private bool isPenDriveBacking;
    private string backupMsg = string.Empty;
    private string penDriveMsg = string.Empty;
    private IBrowserFile? restoreFile;

    protected override async Task OnInitializedAsync()
    {
        await RefreshHistory();
        RefreshDrives();
    }

    private async Task TakeManualBackup()
    {
        isBacking = true;
        backupMsg = string.Empty;
        try
        {
            var log = await BackupService.TakeBackupAsync("Manual", AppState.Username);
            backupMsg = $"✅ Backup complete! {log.FileSizeBytes / 1024:N0} KB saved.";
            await RefreshHistory();
        }
        catch (Exception ex)
        {
            backupMsg = $"❌ Failed: {ex.Message}";
        }
        isBacking = false;
    }

    private async Task BackupToPenDrive()
    {
        isPenDriveBacking = true;
        penDriveMsg = string.Empty;
        try
        {
            await BackupService.BackupToPenDriveAsync(selectedDrive, AppState.Username);
            penDriveMsg = "✅ Backup saved to pen drive!";
            await RefreshHistory();
        }
        catch (Exception ex)
        {
            penDriveMsg = $"❌ Failed: {ex.Message}";
        }
        isPenDriveBacking = false;
    }

    private void RefreshDrives() => drives = BackupService.GetAvailableDrives();

    private async Task RefreshHistory() => backupLogs = await BackupService.GetBackupHistoryAsync();

    private void OnRestoreFileSelected(InputFileChangeEventArgs e) => restoreFile = e.File;

    private async Task ConfirmRestore()
    {
        if (restoreFile == null) return;
        using var ms = new MemoryStream();
        await restoreFile.OpenReadStream(50 * 1024 * 1024).CopyToAsync(ms);
        var tempPath = Path.GetTempFileName();
        await File.WriteAllBytesAsync(tempPath, ms.ToArray());
        await BackupService.RestoreFromFileAsync(tempPath);
        File.Delete(tempPath);
        Toast.ShowSuccess("Database restored! Please refresh the application.");
    }
}
