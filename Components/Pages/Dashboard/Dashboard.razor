@page "/"
@rendermode InteractiveServer
@inject AppState AppState
@inject FeeService FeeService
@inject StudentService StudentService
@inject SchoolService SchoolService
@inject BackupService BackupService

<PageTitle>Dashboard - School ERP</PageTitle>

@if (!AppState.IsAuthenticated)
{
    <div class="text-center py-5">Redirecting to login...</div>
    return;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-0">Dashboard</h4>
        <small class="text-muted">Welcome back, @AppState.FullName! &nbsp;|&nbsp; @DateTime.Now.ToString("dddd, dd MMMM yyyy")</small>
    </div>
</div>

<!-- STAT CARDS -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="icon-box bg-primary bg-opacity-10">
                    <i class="bi bi-people-fill text-primary"></i>
                </div>
                <div>
                    <div class="text-muted small">Total Students</div>
                    <div class="fs-3 fw-bold">@totalStudents.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="icon-box bg-success bg-opacity-10">
                    <i class="bi bi-cash-coin text-success"></i>
                </div>
                <div>
                    <div class="text-muted small">Today's Collection</div>
                    <div class="fs-3 fw-bold text-success">₹@todayCollection.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="icon-box bg-info bg-opacity-10">
                    <i class="bi bi-calendar-month text-info"></i>
                </div>
                <div>
                    <div class="text-muted small">This Month</div>
                    <div class="fs-3 fw-bold text-info">₹@monthlyCollection.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="icon-box bg-warning bg-opacity-10">
                    <i class="bi bi-building text-warning"></i>
                </div>
                <div>
                    <div class="text-muted small">Total Schools</div>
                    <div class="fs-3 fw-bold text-warning">@totalSchools</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Recent Transactions -->
    <div class="col-12 col-xl-8">
        <div class="card table-card">
            <div class="card-header bg-white d-flex align-items-center justify-content-between py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>Recent Transactions</h6>
                <a href="/fees/history" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (recentPayments.Count == 0)
                {
                    <div class="text-center text-muted py-4">No transactions yet</div>
                }
                else
                {
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Receipt</th>
                                <th>Student</th>
                                <th>Month</th>
                                <th>Amount</th>
                                <th>Mode</th>
                                <th>Time</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in recentPayments)
                            {
                                <tr>
                                    <td><code class="text-primary">@p.ReceiptNumber</code></td>
                                    <td>
                                        <div class="fw-semibold">@p.Student?.FullName</div>
                                    </td>
                                    <td><span class="badge bg-light text-dark">@p.Month</span></td>
                                    <td class="fw-bold text-success">₹@p.NetAmount.ToString("N0")</td>
                                    <td><span class="badge bg-secondary">@p.PaymentMode</span></td>
                                    <td class="text-muted small">@p.CreatedAt.ToString("hh:mm tt")</td>
                                    <td>
                                        <a href="/api/receipt/@p.Id" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <!-- Sidebar: Backup Status + Birthdays -->
    <div class="col-12 col-xl-4">
        <!-- Backup Status -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-hdd-fill me-2"></i>Backup Status</h6>
                    <a href="/settings/backup" class="btn btn-sm btn-outline-secondary">Manage</a>
                </div>
                @if (lastBackup == null)
                {
                    <div class="d-flex align-items-center gap-2 text-danger">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <div>
                            <div class="fw-semibold">No backup taken!</div>
                            <small>Please take a backup immediately</small>
                        </div>
                    </div>
                }
                else
                {
                    var daysSince = (DateTime.Now - lastBackup.CreatedAt).TotalDays;
                    var statusClass = daysSince < 1 ? "backup-status-ok" : daysSince < 3 ? "backup-status-warn" : "backup-status-danger";
                    var icon = daysSince < 1 ? "bi-check-circle-fill" : daysSince < 3 ? "bi-exclamation-triangle-fill" : "bi-x-circle-fill";
                    <div class="d-flex align-items-center gap-2 @statusClass">
                        <i class="bi @icon fs-5"></i>
                        <div>
                            <div class="fw-semibold">Last: @lastBackup.CreatedAt.ToString("dd MMM, hh:mm tt")</div>
                            <small>@(lastBackup.FileSizeBytes / 1024 / 1024.0:F1) MB &bull; @lastBackup.BackupType</small>
                        </div>
                    </div>
                }
                <div class="mt-3">
                    <button class="btn btn-primary btn-sm w-100" @onclick="TakeBackup" disabled="@isBackingUp">
                        @if (isBackingUp)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="bi bi-hdd-fill me-2"></i>
                        }
                        Backup Now
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(backupMsg))
                {
                    <div class="alert alert-success py-1 mt-2 mb-0 small">@backupMsg</div>
                }
            </div>
        </div>

        <!-- 6-Month Chart -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-bar-chart-fill me-2 text-primary"></i>Collection (6 Months)</h6>
            </div>
            <div class="card-body">
                @if (chartData.Count > 0)
                {
                    var max = chartData.Max(c => c.Amount);
                    <div class="chart-bar-container">
                        @foreach (var c in chartData)
                        {
                            var pct = max > 0 ? (double)c.Amount / (double)max * 100 : 2;
                            <div class="chart-bar-item">
                                <div style="flex:1;display:flex;align-items:flex-end;width:100%">
                                    <div class="chart-bar" style="height:@pct%;width:100%"
                                         title="@c.Month: ₹@c.Amount.ToString("N0")"></div>
                                </div>
                                <div class="chart-bar-label">@c.Month</div>
                            </div>
                        }
                    </div>
                    <div class="text-center text-muted small mt-1">
                        Total: ₹@chartData.Sum(c => c.Amount).ToString("N0")
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private int totalStudents;
    private decimal todayCollection;
    private decimal monthlyCollection;
    private int totalSchools;
    private List<FeePayment> recentPayments = new();
    private List<(string Month, decimal Amount)> chartData = new();
    private BackupLog? lastBackup;
    private bool isBackingUp;
    private string backupMsg = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.IsAuthenticated) return;

        var schoolId = AppState.CurrentSchoolId;
        if (schoolId == 0) return;

        await Task.WhenAll(
            LoadStatsAsync(schoolId),
            LoadBackupStatusAsync()
        );
    }

    private async Task LoadStatsAsync(int schoolId)
    {
        totalStudents = await StudentService.GetCountAsync(schoolId);
        todayCollection = await FeeService.GetTodayCollectionAsync(schoolId);
        monthlyCollection = await FeeService.GetMonthlyCollectionAsync(schoolId);

        var schools = await SchoolService.GetByUserAsync(AppState.UserId, AppState.Role);
        totalSchools = schools.Count;

        recentPayments = await FeeService.GetRecentPaymentsAsync(schoolId, 10);
        chartData = await FeeService.GetMonthlyChartDataAsync(schoolId);
    }

    private async Task LoadBackupStatusAsync()
    {
        lastBackup = await BackupService.GetLastBackupAsync();
    }

    private async Task TakeBackup()
    {
        isBackingUp = true;
        backupMsg = string.Empty;
        StateHasChanged();

        try
        {
            var log = await BackupService.TakeBackupAsync("Manual", AppState.Username);
            backupMsg = $"✅ Backup done! {log.FileSizeBytes / 1024:N0} KB";
            lastBackup = log;
        }
        catch (Exception ex)
        {
            backupMsg = $"❌ Failed: {ex.Message}";
        }

        isBackingUp = false;
    }
}
