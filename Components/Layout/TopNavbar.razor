@inject AppState AppState
@inject NavigationManager Nav
@inject SchoolService SchoolService

<nav class="top-navbar">
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-sm btn-light d-md-none" onclick="document.getElementById('sidebar').classList.toggle('show')">
            <i class="bi bi-list fs-5"></i>
        </button>

        @if (AppState.IsAuthenticated && schools.Count > 1)
        {
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-building text-muted"></i>
                <select class="form-select form-select-sm" style="width:200px"
                        value="@AppState.CurrentSchoolId"
                        @onchange="OnSchoolChange">
                    @foreach (var school in schools)
                    {
                        <option value="@school.Id">@school.Name</option>
                    }
                </select>
            </div>
        }
    </div>

    <div class="d-flex align-items-center gap-3">
        @if (AppState.CanCollectFee)
        {
            <a href="/fees/collect" class="btn btn-primary btn-sm">
                <i class="bi bi-cash-coin me-1"></i> Collect Fee
            </a>
        }

        <div class="dropdown">
            <button class="btn btn-light btn-sm dropdown-toggle d-flex align-items-center gap-2"
                    data-bs-toggle="dropdown">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                     style="width:30px;height:30px;font-size:0.75rem;font-weight:700">
                    @AppState.FullName.FirstOrDefault()
                </div>
                <span class="d-none d-md-inline">@AppState.FullName</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow">
                <li><h6 class="dropdown-header">@AppState.Role</h6></li>
                <li><a class="dropdown-item" href="/profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                <li><a class="dropdown-item" href="/change-password"><i class="bi bi-key me-2"></i>Change Password</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form action="/logout" method="post">
                        <AntiforgeryToken />
                        <button type="submit" class="dropdown-item text-danger">
                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</nav>

@code {
    private List<School> schools = new();

    protected override async Task OnInitializedAsync()
    {
        if (AppState.IsAuthenticated)
        {
            schools = await SchoolService.GetByUserAsync(AppState.UserId, AppState.Role);
            if (AppState.CurrentSchoolId == 0 && schools.Count > 0)
            {
                AppState.CurrentSchoolId = schools[0].Id;
                AppState.CurrentSchoolName = schools[0].Name;
            }
        }
    }

    private void OnSchoolChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            var school = schools.FirstOrDefault(s => s.Id == id);
            if (school != null)
            {
                AppState.CurrentSchoolId = school.Id;
                AppState.CurrentSchoolName = school.Name;
                AppState.NotifyStateChanged();
                Nav.NavigateTo("/", forceLoad: false);
            }
        }
    }
}
